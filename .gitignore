# =========================================================================
# SECRETS / CREDENTIALS — never commit
# =========================================================================
# .env holds live database, DigiLocker, Vault, issuer and CRE caller keys.
.env
.env.*
!.env.example

# Sandbox / DigiLocker API key exports, however they are named.
*_key.csv
*_keys.csv
sbox_live_key.csv
sbox_test_key.csv
*.pem
# Dev TLS material (arv's `pnpm cert:dev`). Regenerated in one command, and a
# committed private key is a committed private key even in development.
apps/api/certs/
*.p12
*.pfx
*.keystore

# NOTE: packages/cre-workflows/secrets.yaml is deliberately NOT ignored. It
# maps a secret ID to the NAME of the env var holding the value — it contains
# no value itself, and `cre workflow deploy` needs it. Ignoring it by a blanket
# "secrets.yaml" rule would silently break a fresh clone's deploy.

# Anything that looks like a dumped credential or token.
*.credentials
*credentials.json
*token.json

# MCP server config. Normally shareable, but ours carry Authorization headers
# with live API keys (World ID Developer Portal), so a project-scoped .mcp.json
# is a credential file. Servers are added at LOCAL scope (~/.claude.json,
# outside the repo); this is the belt-and-braces in case one is ever added
# with --scope project.
.mcp.json
.claude/hooks.json

# =========================================================================
# REAL PII (Aadhaar / PAN extracts) — never commit
# =========================================================================
digilocker_extract.txt
*.aadhaar.xml
*.pan.xml
aadhaar.xml
pan.xml
kyc_dumps/

# Recorded DigiLocker fixtures contain a real person's Aadhaar + PAN.
# Ignored wholesale except the README. NOTE: must be "dir/*" not "dir/" below —
# a trailing-slash directory pattern prunes traversal before git ever evaluates
# the negation on files inside it, silently swallowing the exception.
fixtures/digilocker/*
!fixtures/digilocker/README.md

# =========================================================================
# TOOLING / EDITOR — local to one machine, not to the project
# =========================================================================
.claude/
.cursor/
.vscode/
.idea/
*.swp
*.swo
*~

# =========================================================================
# BUILD OUTPUT / CACHES
# =========================================================================
node_modules/
dist/
build/
out/
.next/
coverage/
.turbo/
.vite/
*.tsbuildinfo
# Regenerated by `next dev`/`next build` on every run; Next's own template
# ignores it. Committing it only produces churn.
next-env.d.ts

# CRE build artifacts — regenerated by `cre workflow simulate|deploy`.
.cre_build_tmp.*
*.wasm.br.b64
# Generated per-run trigger payload; carries a live requestId.
packages/cre-workflows/src/cre/sim-payload.json

# Prisma engines are downloaded, not authored.
prisma/generated/
.prisma/

# =========================================================================
# SCRATCH / LOGS / OS
# =========================================================================
.archive/
tmp/
temp/
*.tmp
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# --- REFERENCE MATERIAL, not source ---
# Papers and PDFs read during design. Kept on disk, out of the repo: they are
# large, they are not ours to redistribute, and nothing builds from them.
docs/reference/*.pdf
*.pdf
