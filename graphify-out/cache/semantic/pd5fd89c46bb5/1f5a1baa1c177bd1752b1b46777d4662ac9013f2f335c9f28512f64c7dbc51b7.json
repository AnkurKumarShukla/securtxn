{"nodes": [{"id": "apps_api_readme_cp_api", "label": "@cp/api core platform", "file_type": "document", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single Fastify service holding vendor registry, decision engine, evidence hash-chain and exception desk; deliberately excludes any signing capability so that the blast radius of a compromised cloud process stops at proposals."}, {"id": "apps_api_readme_vertical_slice_modules", "label": "Vertical slice module layout", "file_type": "rationale", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modules are vertical slices rather than a shared routes/ + services/ split: each domain's HTTP surface, business logic and validation live together, and cross-module calls go through a service, never through another module's routes."}, {"id": "apps_api_readme_container_di_root", "label": "container.ts DI root", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only place a swappable implementation is chosen, so provider substitution (mock vs live identity provider, fallback vs CRE vendor matcher) never leaks into call sites."}, {"id": "apps_api_readme_pure_decision_engine", "label": "Pure decision state machine", "file_type": "rationale", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "decision/ and evidence/chain.ts are deliberately pure with no DB or network imports, so the two things that must be auditable are testable in isolation."}, {"id": "apps_api_readme_evidence_hash_chain", "label": "Evidence hash-chain", "file_type": "concept", "source_file": "apps/api/README.md", "source_location