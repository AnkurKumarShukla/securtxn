{"nodes": [{"id": "apps_web_readme_cp_web", "label": "@cp/web AP dashboard", "file_type": "document", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Components are grouped by domain, mirroring the api's module slices, so a change to one domain touches one folder on each side."}, {"id": "apps_web_readme_selfie_check_widget", "label": "World ID Selfie Check widget", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "apps_web_readme_medium_assurance_copy_constraint", "label": "Medium-assurance copy constraint", "file_type": "rationale", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selfie Check is medium assurance, so copy must say \"a live human confirmed this action\", never \"identity verified\" (\u00a74.6). Overclaiming the assurance level in UI text is a compliance defect, not a wording preference."}, {"id": "apps_web_readme_aadhaar_last4_only", "label": "Aadhaar last-4 display only", "file_type": "rationale", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aadhaar is only ever shown as last-4 and no input may accept a full Aadhaar number, because receiving one creates Data Vault obligations this flow is designed to avoid (\u00a73)."}, {"id": "apps_web_readme_evidence_chain_viewer", "label": "Evidence chain viewer", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows the break point when the chain is invalid rather than a generic failure, so an auditor can localise tampering."}, {"