{"nodes": [{"id": "fixtures_digilocker_readme_real_fixture_tier", "label": "Real DigiLocker fixture tier", "file_type": "document", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": "2026-09-08", "author": null, "contributor": null, "rationale": "Captured from the live Sandbox API on 2026-09-08 so day-to-day development doesn't burn paid verification calls: every KYC call except /authenticate and /status is billable live, replaying is free."}, {"id": "fixtures_digilocker_readme_two_tier_strategy", "label": "Two-tier fixture strategy", "file_type": "rationale", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It is real-and-secret or synthetic-and-unsigned; there is no redacted middle ground that still validates, because editing one byte of a signed XML invalidates the XMLDSig signature. Hence a gitignored real tier for signature tests and a committed synthetic tier for CI and UI."}, {"id": "fixtures_digilocker_readme_xmldsig_signature", "label": "XMLDSig signatures from UIDAI and Income Tax Department", "file_type": "concept", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "fixtures_digilocker_readme_mockidentityprovider", "label": "MockIdentityProvider fixture replayer", "file_type": "concept", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads index.json, matches on method + path, returns the fixture body, and serves documents/*.xml in place of the presigned URL, so the provider seam is the only thing that changes between mock and live."}, {"id": "fixtures_digilocker_readme_expected_check_results", "label": "index.json expected_check_results oracle", "file_type": "concept", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Values live only in the gitignored index.json and are read at runtime by apps/api/test/fixtures/oracle.ts rather than hardcoded into tests, because they identify a real person."}, {"id": "fixtures_digilocker_readme_oracle_ts", "label": "apps/api/test/fixtures/oracle.ts", "file_type": "code", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "fixtures_digilocker_readme_normalisation_gotchas", "label": "Three-way format inconsistency (date, gender, name case)", "file_type": "concept", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same person's details are formatted three different ways across endpoints (profile DD/MM/YYYY vs XML DD-MM-YYYY; male / M / MALE; Aadhaar title case vs PAN all caps). Normalise before comparing or the cross-document consistency check falsely rejects a legitimate user."}, {"id": "fixtures_digilocker_readme_cross_doc_consistency_check", "label": "crossDocConsistent check", "file_type": "concept", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "fixtures_digilocker_readme_tier3_address", "label": "TIER3_ADDRESS resulting tier", "file_type": "concept", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "fixtures_digilocker_readme_presigned_url_expiry", "label": "Short-lived presigned document URLs", "file_type": "concept", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Document URLs in live responses expire within minutes: download immediately, never persist the URL. Fixture values are marked SYNTHETIC for the same reason tokens are \u2014 credentials and expiring URLs do not belong in a fixture."}, {"id": "fixtures_digilocker_readme_sandbox_test_api_unusable", "label": "Vendor test environment rejected", "file_type": "rationale", "source_file": "fixtures/digilocker/README.md", "source_location": null, "source_url": null, "captured_at": "2026-09-08", "author": null, "contributor": null, "rationale": "test-api.sandbox.co.in is a mock replayer answering only requests that exactly match examples in a forked Postman collection; no DigiLocker examples exist on the account so every DigiLocker call 404s (verified 2026-09-08, including with payloads copied verbatim from vendor docs). Even working, it would return canned data, never a real signed document."}], "edges": [{"source": "fixtures_digilocker_readme_real_fixture_tier", "target": "fixtures_digilocker_readme_two_tier_strategy", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fixtures/digilocker/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_digilocker_readme_two_tier_strategy", "target": "fixtures_digilocker_readme_xmldsig_signature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fixtures/digilocker/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_digilocker_readme_real_fixture_tier", "target": "fixtures_digilocker_synthetic_readme_synthetic_fixture_tier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fixtures/digilocker/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_digilocker_readme_normalisation_gotchas", "target": "fixtures_digilocker_readme_cross_doc_consistency_check", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fixtures/digilocker/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_digilocker_readme_normalisation_gotchas", "target": "apps_api_readme_identity_four_checks", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "fixtures/digilocker/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_digilocker_readme_expected_check_results", "target": "fixtures_digilocker_readme_oracle_ts", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fixtures/digilocker/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_digilocker_readme_expected_check_results", "target": "fixtures_digilocker_readme_tier3_address", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fixtures/digilocker/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_digilocker_readme_expected_check_results", "target": "fixtures_digilocker_readme_cross_doc_consistency_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fixtures/digilocker/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_digilocker_readme_mockidentityprovider", "target": "fixtures_digilocker_readme_expected_check_results", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fixtures/digilocker/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_digilocker_readme_mockidentityprovider", "target": "apps_api_readme_container_di_root", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "fixtures/digilocker/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_digilocker_readme_sandbox_t