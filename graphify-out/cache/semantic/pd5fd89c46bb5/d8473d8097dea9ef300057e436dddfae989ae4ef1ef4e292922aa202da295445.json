{"nodes": [{"id": "fixtures_worldid_readme_selfie_check_fixtures", "label": "World ID Selfie Check fixtures", "file_type": "document", "source_file": "fixtures/worldid/README.md", "source_location": null, "source_url": null, "captured_at": "2026-09-09", "author": null, "contributor": null, "rationale": "Two real sandbox verifications captured 2026-09-09 so tests can replay the flow without a phone, a camera, or the World verifier being reachable \u2014 same purpose as fixtures/digilocker/, but committed."}, {"id": "fixtures_worldid_readme_nullifier", "label": "Nullifier as scoped pseudonym", "file_type": "concept", "source_file": "fixtures/worldid/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A one-way, RP- and action-scoped pseudonym: it cannot be reversed to a person and is meaningless outside our rp_id, which is why these fixtures carry no identity data and can be committed."}, {"id": "fixtures_worldid_readme_zk_proof_signal_binding", "label": "Empty-signal proof binding", "file_type": "rationale", "source_file": "fixtures/worldid/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The committed proofs are genuine ZK proofs but bound to the empty signal, while every gate requires a proof bound to a specific signal checked server-side \u2014 so they cannot be replayed for anything that matters. If a capture is ever taken with a real signal against production, re-evaluate before committing."}, {"id": "fixtures_worldid_readme_unique_nullifier_action_signal", "label": "UNIQUE (nullifier, action, signal) constraint", "file_type": "concept", "source_file": "fixtures/worldid/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database-level backstop: proof reuse is caught regardless of application logic."}, {"id": "fixtures_worldid_readme_nullifier_continuity", "label": "Nullifier continuity property", "file_type": "concept", "source_file": "fixtures/worldid/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture 02 has a different nonce, merkle_root and proof bytes from capture 01 yet the same nullifier \u2014 proving same human, same action, same nullifier, forever, which is what the onboarding-to-approval design depends on (see D49a)."}, {"id": "fixtures_worldid_readme_biometric_never_leaves_world_id", "label": "Biometric stays inside World ID (D49)", "file_type": "concept", "source_file": "fixtures/worldid/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "World never returns the face: no name, no document, no image, no facial template reaches this platform."}, {"id": "fixtures_worldid_readme_known_gotchas", "label": "index.json known_gotchas oracle", "file_type": "concept", "source_file": "fixtures/worldid/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "index.json states what a correct implementation must conclude; four of the five gotchas are traps that fail silently, so it must be read before writing anything against the fixtures."}], "edges": [{"source": "fixtures_worldid_readme_selfie_check_fixtures", "target": "fixtures_digilocker_readme_real_fixture_tier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fixtures/worldid/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_worldid_readme_nullifier", "target": "fixtures_worldid_readme_selfie_check_fixtures", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fixtures/worldid/README.md", "source_location": null, "weight": 1.0}, {"source": "fixtures_worldid_readme_zk_proof_signal_binding", "targ