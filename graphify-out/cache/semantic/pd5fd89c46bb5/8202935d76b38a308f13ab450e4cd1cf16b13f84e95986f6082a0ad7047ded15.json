{"nodes": [{"id": "packages_cre_workflows_project_staging_settings", "label": "CRE project staging/production settings", "file_type": "document", "source_file": "packages/cre-workflows/project.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "packages_cre_workflows_project_unconditional_rpc_requirement", "label": "Unused-but-required RPC configuration", "file_type": "rationale", "source_file": "packages/cre-workflows/project.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The workflow does not read or write a chain \u2014 its result is the HTTP trigger's synchronous response, not an on-chain report \u2014 but simulate still requires at least one RPC under the target because the simulator's runtime initializes chain clients unconditionally (confirmed by the error \"no RPC URLs found for target\"). Extend only if a future revision writes on-chain via usingTheDons()."}, {"id": "packages_cre_workflows_project_vault_don_mainnet_secrets", "label": "Vault DON secrets on the mainnet registry", "file_type": "rationale", "source_file": "packages/cre-workflows/project.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vault DON secrets live on the mainnet registry even for a staging workflow; without an ethereum-mainnet RPC the secrets commands stop on an interactive \"responses cannot be validated\" prompt \u2014 the CLI correctly refusing to trust a gateway reply it cannot check against the chain. Supplying the RPC is supplying the check, not skipping it."}], "edges": [{"source": "packages_cre_workflows_project_unconditional_rpc_requirement", "target": "packages_cre_workflows_project_staging_settings", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/cre-workflows/project.yaml", "source_location": null, "weight": 1.0}, {"source": "packages_cre_workflows_project_unconditional_rpc_requirement", "target": "packages_cre_workflows_readme_simulate_not_security_demo", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "packages/cre-workflows/project.yaml", "source_location": null, "weight": 1.0}, {"source": "packages_cre_workflows_project_vault_don_mainnet_secrets", "target": "packages_cre_workflows_project_staging_settings", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/cre-workflows/project.yaml", "source_location": null, "weight": 1.0}, {"source": "packages_cre_workflows_project_unconditional_rpc_requirement", "target": "packages_cre_workflows_readme_cre_tee_handler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/cre-workflows/project.yaml", "source_location": null, "weight": 1.0}], "hyperedges": []}