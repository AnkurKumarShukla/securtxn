# Copy to .env and fill in. .env is gitignored; this file is the committed template.
# Canonical list lives in ARCHITECTURE.md §9 — keep the two in sync.

DATABASE_URL=postgresql://postgres:postgrespw@localhost:5432/confirmed_payee?schema=public
# Local dev runs Postgres in Docker. If the container is recreated the host port changes.

# --- server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
BODY_LIMIT_BYTES=1048576
ENABLE_DOCS=true

# --- crypto / secrets (KMS-managed in production, never hardcoded) ---
HMAC_PEPPER=
PII_ENCRYPTION_KEY=                   # AES-256-GCM key for column-level encryption (§5)

# --- auth: one secret per role, roles are architecturally separate (§4.2) ---
JWT_AGENT_SECRET=
JWT_APPROVER_SECRET=
JWT_BRIDGE_SECRET=

# --- identity: digilocker | generic | mock (§4.7) ---
IDENTITY_PROVIDER=mock
SANDBOX_BASE_URL=https://api.sandbox.co.in
SANDBOX_LIVE_KEY=key_live_...
SANDBOX_LIVE_SECRET=secret_live_...   # MUST start with secret_live_, NOT key_live_
DIGILOCKER_REDIRECT_URL=              # callback; carries onboardingSessionNonce in state
DIGILOCKER_FIXTURE_DIR=./fixtures/digilocker-synthetic   # real tier: ./fixtures/digilocker

# Risk appetite: largest payment each verification tier may receive (§4.1).
# A tier omitted from this map has no ceiling.
TIER_AMOUNT_LIMITS={"TIER0_UNVERIFIED":"0","TIER1_LIVENESS":"1000","TIER2_IDENTITY":"50000"}

# --- vendor match: fallback | cre (§4.4) ---
VENDOR_MATCHER=fallback
CRE_ENROLLMENT_ID=                    # blank until enrollment confirmed

# --- World ID Selfie Check (§4.6) ---
WORLD_APP_ID=
WORLD_FEATURE_FLAG_ENABLED=false      # flip once World confirms access

# --- Hedera: ATS + HCS anchoring (§4.5, §4.8) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HCS_TOPIC_ID=
HEDERA_CHAIN_ID=296                   # 296 = testnet, 295 = mainnet
# Signs verifiable credentials and submits grantKyc/revokeKyc (D40/D42).
# Absent means credentials are not issued — fails closed, does not block
# wallet confirmation (D43's test coverage: credential-issuance.test.ts).
ATS_ISSUER_PRIVATE_KEY=
ATS_SECURITY_ID=                      # the deployed security (diamond) address

# --- approval bridge (runs on the approver's machine, NOT in cloud infra) ---
API_BASE_URL=https://localhost:3000
WALLET_CLI_TRANSPORT=mock             # mock | usb | speculos — mock until Track B3
