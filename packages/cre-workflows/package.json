{
  "name": "@cp/cre-workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cre": {
      "types": "./src/cre/index.ts",
      "default": "./src/cre/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "simulate": "cre workflow simulate ./src/cre --target staging-settings --non-interactive --trigger-index 0 --http-payload ./src/cre/payloads/sample-trigger-payload.json",
    "invoke:deployed": "dotenv -e ../../.env -- node scripts/invoke-workflow.mjs"
  },
  "dependencies": {
    "@cp/shared-types": "workspace:*",
    "@chainlink/cre-sdk": "1.20.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.0",
    "typescript": "^5.6.0",
    "viem": "^2.21.0",
    "vitest": "^2.1.0"
  }
}
