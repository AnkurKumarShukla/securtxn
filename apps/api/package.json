{
  "name": "@cp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --include ../../.env --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "seed": "tsx prisma/seed.ts",
    "prisma": "dotenv -e ../../.env -- prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "mint:token": "dotenv -e ../../.env -- tsx scripts/mint-token.ts",
    "flow:smoke": "dotenv -e ../../.env -- tsx scripts/flow-smoke.ts",
    "cre:e2e": "dotenv -e ../../.env -- tsx scripts/cre-e2e.ts",
    "cre:request": "dotenv -e ../../.env -- node scripts/new-match-request.mjs",
    "cre:show": "dotenv -e ../../.env -- node scripts/show-match-request.mjs",
    "cert:dev": "bash scripts/generate-dev-cert.sh",
    "smoke:chain": "tsx scripts/live-chain-smoke.ts",
    "smoke:anchor": "tsx scripts/anchor-smoke.ts",
    "start:built": "node dist/index.js"
  },
  "//": "Dependencies are added when the phase that uses them starts (docs/progress.md). viem, xml-crypto, @xmldom/xmldom and @hashgraph/sdk arrive with A3/A4 and Track B.",
  "dependencies": {
    "@cp/contracts": "workspace:*",
    "@cp/cre-workflows": "workspace:*",
    "@cp/shared-types": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@prisma/client": "^6.1.0",
    "@worldcoin/idkit-core": "^4.2.4",
    "@xmldom/xmldom": "^0.9.12",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "tsx": "^4.19.2",
    "viem": "^2.21.0",
    "xml-crypto": "^6.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv-cli": "^7.4.4",
    "jsonwebtoken": "^9.0.3",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
