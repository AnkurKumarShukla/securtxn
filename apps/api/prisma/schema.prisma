// Canonical data model. docs/architecture.md §3 is the source of truth for the
// shapes here; every service is built against them.
//
// Deviations from §3 are marked "DEVIATION" with the reason. They are all
// integrity constraints the prose already implies but the schema block did not
// express — see docs/decisions.md D25.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WalletStatus {
  PENDING_VERIFICATION
  CONFIRMED
  REVOKED
}

enum PaymentDecision {
  SAFE_TO_SEND
  DO_NOT_SEND
  REVERIFY
  SEND_TEST_AMOUNT
}

enum PaymentStatus {
  DRAFT
  AWAITING_PAYEE_CONSENT
  DECISION_PENDING
  AWAITING_APPROVAL
  APPROVED
  SENT
  CONFIRMED_ON_CHAIN
  EXCEPTION
}

/// A tokenized instrument's state. MATURED is terminal for new issuance
/// activity: a matured bond takes no new coupons, only redemptions.
enum SecurityStatus {
  ISSUED
  MATURED
}

/// What happened to a security. One row per confirmed on-chain operation, so
/// the UI can show a history without replaying the chain.
enum SecurityEventKind {
  ISSUED
  PREPARED
  MINTED
  TRANSFERRED
  COUPON_SET
  MATURITY_UPDATED
  REDEEMED
}

/// How a payment settles. Per payment, never a global switch (D41).
///
/// DIRECT is a plain transfer and stays the default: a payee who will not or
/// cannot claim still gets paid. HTLC routes the same payment through a hashed
/// timelock escrow, so the payee must reveal a secret to take the funds and
/// anything unclaimed returns to the payer.
enum SettlementMode {
  DIRECT
  HTLC
}

/// One escrow's lifecycle. CLAIMED and REFUNDED are mutually exclusive on
/// chain — the contract closes claiming the moment the timelock passes.
enum HtlcStatus {
  /// Authorised and prepared, but the money has not moved yet.
  ///
  /// Exists because the PAYER funds the escrow from their own wallet. The
  /// platform generates the secret and fixes every lock parameter at approval
  /// time — it must, because the preimage cannot be handed to the payer without
  /// handing them the escrow — but it cannot broadcast, since it does not hold
  /// their key. So the settlement is real before it is on chain: this row IS
  /// the instruction the payer's wallet is asked to execute, and the lock id
  /// computed here is what their transaction is checked against.
  PENDING_LOCK
  LOCKED
  CLAIMED
  REFUNDED
}

/// How a recipient acknowledged receipt. Two routes to the same fact: one is
/// asked for after the money moves, the other falls out of collecting it.
enum AcknowledgmentMethod {
  EIP712_SIGNATURE
  HTLC_CLAIM
}

enum ExceptionType {
  OVERPAY
  MISDIRECT
  DUPLICATE
  WRONG_ASSET
  DISPUTE
}

enum ExceptionStatus {
  OPEN
  IN_RECOVERY
  RESOLVED
  WRITTEN_OFF
}

enum PayeeType {
  INDIVIDUAL // freelancer, contractor, sole supplier — NO business registry exists for these
  BUSINESS
}

enum VerificationTier {
  TIER0_UNVERIFIED // wallet signature only — never eligible for SAFE_TO_SEND
  TIER1_LIVENESS // + Selfie Check liveness + phone OTP
  TIER2_IDENTITY // + government ID document with face match to liveness selfie
  TIER3_ADDRESS // + physically verified address (postcard code preferred)
}

// DEVIATION: §3 types these three as String with the allowed values in a
// comment. They are closed vocabularies that gate risk decisions, so an
// unexpected value must be a migration, not a row. idDocumentType stays a
// String — that set genuinely grows per country and per KYC provider.
enum KybStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PhoneLineType {
  MOBILE
  LANDLINE
  VOIP // disposable — NOT usable for a dispute callout, must be flagged weak
}

enum AddressVerifiedMethod {
  POSTCARD_CODE // strongest
  ID_DOCUMENT // India: DigiLocker Aadhaar Poa
  DATABASE_LOOKUP
  UNVERIFIED
}

/// Encrypted blobs kept in Postgres rather than an object store.
///
/// §3 describes `photoEncryptedRef` and `rawContextEncryptedRef` as pointers
/// but never says to what. For the MVP the ciphertext lives here and the "ref"
/// is this row's id: one datastore, one backup story, one access-control
/// surface — and these payloads are small (a UIDAI portrait is a few KB).
///
/// The ref is a real foreign key, not a loose string, so a pointer cannot
/// dangle and the blob cannot be deleted out from under the record that cites
/// it (D30).
model EncryptedBlob {
  id   String   @id @default(uuid())
  kind BlobKind

  /// AES-256-GCM. Authenticated, so a tampered blob fails to decrypt rather
  /// than returning plausible garbage.
  ciphertext Bytes
  /// 96-bit IV, fresh per blob. Never reused with the same key.
  iv         Bytes
  authTag    Bytes

  contentType String
  byteLength  Int
  createdAt   DateTime @default(now())

  vendorPhotos    Vendor[]
  acknowledgments RecipientAcknowledgment[]
  htlcPreimages   HtlcSettlement[]

  @@index([kind])
}

enum BlobKind {
  /// UIDAI <Pht> portrait, used for face match against the liveness selfie.
  IDENTITY_PHOTO
  /// Raw context behind a recipient acknowledgment commitment.
  ACK_CONTEXT
  /// The secret a payee must reveal to claim an escrow. Encrypted at rest and
  /// released only to the payee, because anyone holding it can take the money.
  HTLC_PREIMAGE
}

model Vendor {
  id               String           @id @default(uuid())
  payeeType        PayeeType
  verificationTier VerificationTier @default(TIER0_UNVERIFIED)

  // --- INDIVIDUAL payees ---
  legalFirstName        String?
  legalLastName         String?
  dobEncrypted          String? // AES-256-GCM, KMS-wrapped — never plaintext
  idDocumentCheckRef    String? // opaque ref to KYC provider session (Persona/Onfido/Sumsub)
  idDocumentType        String? // PASSPORT_NFC | DRIVING_LICENSE | NATIONAL_ID | DIGILOCKER_AADHAAR
  //                             Government-signed sources (PASSPORT_NFC, DIGILOCKER_AADHAAR)
  //                             are materially stronger than a photo/OCR of a document
  faceMatchScore        Float? // liveness selfie <-> ID document photo
  worldIdSelfieCheckRef String? // liveness/continuity credential

  // --- DIGILOCKER (India) — see §4.7. Verified working against live API 2026-09-08 ---
  digilockerUserId       String?        @unique
  //                         Stable pseudonymous DigiLocker account id, present in BOTH
  //                         the PAN <Person uid> and the Aadhaar KycRes txn string.
  //                         USE THIS as the identity primary key. Never the Aadhaar number.
  digilockerSessionId    String?
  aadhaarLast4           String? // e.g. "1234". UIDAI returns "xxxxxxxx1234" — the full Aadhaar
  //                                number is NEVER exposed by DigiLocker. Do not build any UI
  //                                that asks a user to type it: receiving it would create
  //                                Aadhaar Data Vault obligations this flow otherwise avoids.
  aadhaarKycTtl          DateTime? // KycRes ttl (observed: issue + 1 year). Schedule re-verification
  //                                 before this date; CONFIRMED is not permanent.
  panNumberHmac          String? // HMAC-SHA256(PAN, pepper) — never plaintext
  /// HMAC-SHA256(canonicalEntityName(legal name), pepper).
  ///
  /// The CRE enclave has no crypto, so the match compares digests rather than
  /// decrypting anything (D62). Canonicalisation is dedupe + sort + join of the
  /// suffix-stripped tokens, which preserves the set semantics the old Jaccard
  /// score had — "Meridian Components Pvt Ltd" and "MERIDIAN COMPONENTS PRIVATE
  /// LIMITED" reduce to the same string, therefore the same digest.
  legalNameHmac          String?
  panVerifiedOn          DateTime?
  photoEncryptedRef      String? // -> EncryptedBlob.id. The UIDAI <Pht> portrait, used for face-match.
  photoBlob              EncryptedBlob? @relation(fields: [photoEncryptedRef], references: [id], onDelete: Restrict)
  xmlSignatureVerified   Boolean        @default(false)
  //                                MUST be true before CONFIRMED. See §4.7 — an unverified XML
  //                                is just a text file; the XMLDSig signature IS the security property.
  xmlSignatureVerifiedAt DateTime?
  /// SHA-256 of the raw signed XML, one per document.
  ///
  /// DEVIATION: not in §3. The IdentityBinding attestation signs over these
  /// hashes, so verifying that signature later requires reconstructing the
  /// exact payload — and the raw documents are deliberately not retained.
  /// Without these the attestation is unverifiable after the session ends.
  aadhaarDocHash         String?
  panDocHash             String?

  crossDocConsistent Boolean @default(false)
  //                                name/dob/gender matched across Aadhaar and PAN. Mismatch is a
  //                                strong fraud signal and must block CONFIRMED.

  // --- BUSINESS payees ---
  legalEntityName         String?
  taxIdHmac               String? // HMAC-SHA256(taxId, pepper) — never store raw
  registryVerifiedName    String? // from business-registry lookup; mismatch vs submitted blocks KYB
  registryVerifiedContact String? // contact AS RETURNED BY THE REGISTRY — see callback rule below

  // --- COMMON: verified reachability, used for dispute callout ---
  country                  String
  verifiedPhone            String? // OTP-verified at onboarding, encrypted
  verifiedPhoneAt          DateTime?
  phoneLineType            PhoneLineType? // VOIP/disposable MUST be flagged weak: it is not
  //                                         usable for a real dispute callout
  verifiedEmail            String?
  verifiedAddressEncrypted Json? // structured address, encrypted
  addressVerifiedMethod    AddressVerifiedMethod?
  addressVerifiedAt        DateTime?

  // --- Signed attestation (dispute evidence) ---
  attestationSig      String? // EIP-712 sig over attestationDataHash, signed by the payee's
  //                             wallet key: "I affirm this information about me is true."
  //                             Turns a data-entry claim into signed, repudiation-resistant
  //                             evidence usable in a legal dispute.
  attestationDataHash String?
  attestedAt          DateTime?

  // --- Session binding (see "Identity binding" note in §3) ---
  onboardingSessionNonce String? // MUST be identical across the liveness check, the document
  //                                check, and the wallet control signature. Differing nonces
  //                                means the artifacts may belong to different people — reject.

  kybStatus KybStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  wallets     VendorWallet[]
  payments    PaymentRequest[]
  /// Payments this vendor SENT. Both parties onboard identically, so a vendor
  /// is a payer here and a payee in `payments` (D62 flow, O1-O8).
  paymentsSent  PaymentRequest[] @relation("PaymentPayer")
  notifications Notification[]
  blocksMade    IdentityBlock[]  @relation("BlockOwner")
  blocksAgainst IdentityBlock[]  @relation("BlockTarget")
  credentials VerifiableCredential[]

  @@index([kybStatus])
}

model VendorWallet {
  id             String  @id @default(uuid())
  vendorId       String
  vendor         Vendor  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  address        String
  network        String // e.g. "ethereum", "hedera"
  tokenContract  String?
  version        Int
  supersededById String? @unique // points to the next version once rotated

  // DEVIATION: self-relation made explicit. §3 leaves supersededById a bare
  // string; a dangling pointer would silently break the rotation history that
  // answers "which address was CONFIRMED on date X" (D01).
  supersededBy VendorWallet? @relation("WalletSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes   VendorWallet? @relation("WalletSupersession")

  status              WalletStatus @default(PENDING_VERIFICATION)
  controlProofSig     String? // EIP-712 signature — proves WALLET CUSTODY ONLY.
  //                         Does NOT prove the signer represents the named legal entity.
  //                         Never treat this alone as sufficient for CONFIRMED.
  controlProofNonce   String?
  callbackConfirmedAt DateTime? // out-of-band confirmation timestamp
  callbackChannelUsed String? // the actual phone/contact dialed — MUST equal
  //                             Vendor.registryVerifiedContact for a new vendor, or the
  //                             pre-existing contact on file for an existing vendor's wallet
  //                             change. Reject confirmation if this doesn't match; never
  //                             accept a contact value taken from the current submission.
  callbackConfirmedBy String? // operator who placed the call
  confirmedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  payments   PaymentRequest[]
  credential VerifiableCredential?

  @@unique([vendorId, version]) // DEVIATION: two wallets at the same version would make
  //                               the rotation history ambiguous. §3 had a plain index.
  @@index([vendorId, version])
  // The ERC-3643 identity-registry hook (§4.5) looks wallets up by address.
  // Not unique: an address may legitimately reappear as a later version after
  // revocation. "At most one CONFIRMED wallet per address" is enforced in the
  // service layer, where the status transition happens.
  @@index([address, network])
}

/// A verifiable credential asserting that a wallet passed verification.
///
/// Issued when a VendorWallet reaches CONFIRMED, and referenced on-chain by
/// `grantKyc(account, vcId, validFrom, validTo, issuer)` — the chain stores this
/// row's id and a validity window, never the credential body (D42).
///
/// The body asserts THAT checks passed, never the underlying documents: no
/// name, no address, no Aadhaar digits. A credential is published to a chain by
/// reference and must be safe to disclose in full (design principle 2, D27).
model VerifiableCredential {
  id       String       @id @default(uuid())
  vendorId String
  vendor   Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  walletId String       @unique
  wallet   VendorWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  /// The wallet address the credential is about — the on-chain KYC subject.
  subjectAddress String

  /// The claims, as signed. PII-free by construction.
  claims Json

  /// EIP-712 signature over the claims by the platform issuer key.
  signature     String
  /// Issuer address, matching the `issuer` argument of grantKyc.
  issuerAddress String

  issuedAt  DateTime  @default(now())
  /// From `aadhaarKycTtl`: verification is time-bounded, so the grant is too (D06).
  expiresAt DateTime?
  revokedAt DateTime?

  /// Set once the on-chain grant lands, so a re-run does not double-grant.
  grantedTxHash String?

  @@index([subjectAddress])
  @@index([revokedAt, expiresAt])
}

model PaymentRequest {
  id                      String       @id @default(uuid())
  vendorId                String
  vendor                  Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// What the SENDER believes about the payee, as digests (P1, D62).
  ///
  /// This is the whole point of the match and it did not exist before: the old
  /// code derived the "claim" from the payee's own record and compared it to
  /// itself, so the identity check could never fail. A claim has to come from
  /// the party making it.
  ///
  /// Nullable so pre-existing rows migrate; a payment without them cannot pass
  /// P6, which is the correct failure.
  claimedPayeeNameHmac    String?
  claimedPayeePanHmac     String?

  /// The paying party, onboarded through the same O1-O8 path as the payee.
  /// Optional only so existing rows survive the migration; required for any
  /// payment that goes through the consent flow.
  payerVendorId           String?
  payer                   Vendor?      @relation("PaymentPayer", fields: [payerVendorId], references: [id], onDelete: Restrict)
  vendorWalletId          String
  vendorWallet            VendorWallet @relation(fields: [vendorWalletId], references: [id], onDelete: Restrict)
  invoiceRef              String
  amount                  Decimal      @db.Decimal(38, 18)
  //                                      DEVIATION: explicit precision. ERC-20 stablecoins carry
  //                                      18 decimals; leaving Prisma's default risks silent
  //                                      rounding on a value that moves money.
  token                   String
  network                 String
  senderContextCommitment String // keccak256 hash, see §4.8

  /// Chosen when the payment is raised, not when it is sent. The approver sees
  /// the mode on the proposal, and the mode is part of what they approve.
  payeeConsent   PayeeConsent?

  settlementMode SettlementMode @default(DIRECT)

  decision           PaymentDecision?
  decisionReasonCode String?
  matchScore         Float?
  status             PaymentStatus    @default(DRAFT)
  txHash             String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  proposal        Proposal?
  approvalEvent   ApprovalEvent?
  recipientAck    RecipientAcknowledgment?
  htlcSettlement  HtlcSettlement?
  exceptionCase   ExceptionCase?
  evidenceRecords EvidenceRecord[]

  @@index([vendorId, createdAt])
  @@index([status])
  @@index([txHash]) // reconciliation looks payments up by on-chain hash
}

/// A payment queued for human approval.
///
/// DEVIATION: not in §3, but §4.3's `PendingProposal` contract carries its own
/// id and `proposedAt` — which implies a record, not a derived view of
/// PaymentRequest. Keeping it separate also distinguishes two different facts:
/// "the decision engine permits this" (status AWAITING_APPROVAL) from "an agent
/// actually queued it for a human". Only the second belongs in the approver's
/// queue.
model Proposal {
  id               String         @id @default(uuid())
  paymentRequestId String         @unique
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)

  /// The agent-scoped identity that wrote it. Never an approver (D12).
  proposedBy String

  /// Opaque World ID Selfie Check reference, when the flow captured one.
  /// Never the raw proof (§4.6).
  selfieCheckProofRef String?

  /// Snapshot at proposal time. The queue must show what was true when the
  /// decision was made, not what became true later.
  isNewOrChangedAddress Boolean @default(false)

  createdAt  DateTime  @default(now())
  /// Set when a send is reported against it; a consumed proposal leaves the queue.
  consumedAt DateTime?

  @@index([consumedAt, createdAt])
}

model ApprovalEvent {
  id                  String         @id @default(uuid())
  paymentRequestId    String         @unique
  paymentRequest      PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)
  approverId          String
  selfieCheckVerified Boolean        @default(false)
  selfieCheckProofRef String? // opaque reference to stored IDKit result, not the raw proof
  ledgerConfirmed     Boolean        @default(false)
  ledgerConfirmedAt   DateTime?
  approvedAt          DateTime       @default(now())
}

model RecipientAcknowledgment {
  id                     String         @id @default(uuid())
  paymentRequestId       String         @unique
  paymentRequest         PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)
  recipientAddress       String

  /// DEVIATION from §3, which assumes a signature is always present. It is not:
  /// an HTLC claim acknowledges receipt by revealing a secret in a transaction
  /// the payee signed, and there is no EIP-712 payload anywhere in that flow.
  /// Forcing a value here would mean inventing one (D41).
  method             AcknowledgmentMethod @default(EIP712_SIGNATURE)
  recipientSignature String? // EIP-712 sig over recipientCommitment; null for HTLC_CLAIM
  /// The claim transaction, for HTLC_CLAIM. Null for a signed acknowledgment.
  claimTxHash        String?

  recipientCommitment    String // keccak256 hash of raw context, or the hashlock the payee opened
  rawContextEncryptedRef String? // -> EncryptedBlob.id
  rawContextBlob         EncryptedBlob? @relation(fields: [rawContextEncryptedRef], references: [id], onDelete: Restrict)
  verifiedAt             DateTime       @default(now())
}

/// A tokenized receivable issued through the ATS factory.
///
/// DEVIATION: not in §3, which predates issuance being a product action rather
/// than a deploy script. The row is the platform's index into the chain: the
/// EVM address is authoritative, and everything else here is a cached copy of
/// what was minted so a list screen does not need a mirror-node round trip per
/// row.
model Security {
  id String @id @default(uuid())

  /// Authoritative identity. Hedera also assigns a 0.0.x id, kept when known
  /// because that is what HashScan links and what an operator recognises.
  evmAddress String  @unique
  hederaId   String?

  name     String
  symbol   String
  isin     String
  decimals Int    @default(2)
  currency String @default("USD")

  /// Face value per unit, at nominalValueDecimals precision.
  nominalValue         Decimal @db.Decimal(38, 18)
  nominalValueDecimals Int     @default(2)
  /// Cap in base units, as a string: uint256 does not fit any numeric column.
  maxSupply            String

  startingDate DateTime
  maturityDate DateTime
  status       SecurityStatus @default(ISSUED)

  /// True once the operator is a credential issuer the token trusts. Without
  /// it every grantKyc against this security reverts (D40).
  issuerRegistered Boolean @default(false)

  deployTxHash String
  /// Who issued it, from the issuer token that made the call.
  issuedBy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SecurityEvent[]

  @@index([status])
}

/// One confirmed lifecycle operation on a security.
///
/// Append-only, like the evidence chain and for the same reason: this is the
/// record a reader consults to answer "what was done to this instrument, and
/// by whom". A revisable history answers nothing.
model SecurityEvent {
  id         String   @id @default(uuid())
  securityId String
  security   Security @relation(fields: [securityId], references: [id], onDelete: Restrict)

  kind   SecurityEventKind
  txHash String
  /// The issuer-token subject that triggered it.
  actorId String

  /// Operation-specific fields: the holder and amount for a mint, the rate and
  /// dates for a coupon. Json because the shape genuinely differs per kind, and
  /// seven nullable column groups would describe the union worse.
  detail Json

  createdAt DateTime @default(now())

  @@index([securityId, createdAt])
}

/// One HTLC escrow, mirrored from chain.
///
/// DEVIATION: not in §3 — §3 predates the settlement leg. Kept separate from
/// PaymentRequest rather than adding six nullable columns to it, because these
/// fields exist for exactly the payments that opted in, and a table that is
/// mostly null on most rows stops describing anything. It also keeps the
/// payment status machine intact: LOCKED/CLAIMED/REFUNDED are facts about an
/// escrow, not about whether a payment was approved and sent.
///
/// Nothing here is ever written by this service to a chain. Rows record
/// transactions the bridge already broadcast (D12).
model HtlcSettlement {
  id               String         @id @default(uuid())
  paymentRequestId String         @unique
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)

  escrowAddress String
  /// Derived by the contract from every other field. Re-derived on write, so a
  /// row can always be found on chain.
  lockId        String @unique
  /// keccak256 of the payee's secret. The secret is never stored before it is
  /// spent — it is the only thing standing between anyone and the escrow.
  hashlock      String
  timelock      DateTime
  payerAddress  String
  payeeAddress  String
  /// The token contract the escrow holds. Needed to re-derive the lock id, and
  /// it is what a reader follows to find the transfer on an explorer.
  tokenAddress  String
  amount        Decimal @db.Decimal(38, 18)
  /// The same amount in the token's base units, as the chain saw it. Kept
  /// alongside the human figure rather than derived from it: deriving needs the
  /// token's decimals, and a wrong guess there is a wrong lock id.
  onChainAmount String

  status HtlcStatus @default(LOCKED)

  /// Null while PENDING_LOCK: there is no transaction until the payer sends one.
  lockTxHash   String?
  claimTxHash  String?
  refundTxHash String?
  /// Set on claim. Public by then, and it is the receipt itself.
  preimage     String?

  /// The secret BEFORE it is spent, encrypted at rest -> EncryptedBlob.id.
  ///
  /// Held rather than discarded because the payee has to be given it, and only
  /// after they prove control of the payout address. Anyone holding this can
  /// claim the escrow, so it never appears in a list response and never in the
  /// evidence chain — only the hashlock does.
  preimageEncryptedRef String?
  preimageBlob         EncryptedBlob? @relation(fields: [preimageEncryptedRef], references: [id], onDelete: Restrict)
  preimageReleasedAt   DateTime?

  lockedAt  DateTime  @default(now())
  settledAt DateTime?

  @@index([status])
  @@index([timelock]) // sweeping for locks that are now refundable
}

model ExceptionCase {
  id               String          @id @default(uuid())
  paymentRequestId String          @unique
  paymentRequest   PaymentRequest  @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)
  type             ExceptionType
  status           ExceptionStatus @default(OPEN)
  playbookSteps    Json // ordered array of {step, status, note}
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  resolvedAt       DateTime?

  @@index([status])
}

/// Append-only. Deliberately has no updatedAt: a record that can be revised is
/// not evidence. Corrections are new records, never edits (D07).
model EvidenceRecord {
  id               String         @id @default(uuid())
  paymentRequestId String
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)
  eventType        String // "vendor_match" | "decision" | "approval" | "send" | "ack" |
  //                         "exception_opened" | "evidence_accessed" — open set, validated
  //                         by the Zod schemas in @cp/shared-types (docs/evidence-schema.md)
  /// The canonical payload this record hashed.
  ///
  /// DEVIATION: §3 stores only the hash. But verifying a chain means
  /// RECOMPUTING each hash from its content — with only hashes you can check
  /// that links point at each other, not that any record still says what it
  /// said. And evidence with no content cannot be read back in a dispute,
  /// which is the entire purpose. PII never appears here by construction: the
  /// payload schemas are a closed union of identifiers, enums, scores and
  /// hashes (D27).
  payload          Json

  payloadHash        String // keccak256 of this record's canonical JSON payload
  previousRecordHash String // hash of the prior record in the chain (genesis = "0"*64)
  hcsAnchorTxId      String? // filled in by the batch anchoring job, see §4.8
  createdAt          DateTime @default(now())

  /// The batch whose Merkle root was published to the consensus topic.
  ///
  /// Both this and hcsAnchorTxId are set together and describe the same fact.
  /// The transaction id is kept because §3 names it and because it is what a
  /// person pastes into an explorer; the relation is kept because rebuilding a
  /// batch to produce an inclusion proof needs the sibling records, and finding
  /// them by a string would be a scan.
  anchorId String?
  anchor   EvidenceAnchor? @relation(fields: [anchorId], references: [id], onDelete: Restrict)

  // DEVIATION: §3 ordered the chain by createdAt alone. Two records written in
  // the same transaction can share a timestamp, which makes the order — and so
  // the chain — ambiguous. Uniqueness on the link instead means the chain is
  // reconstructed by following previousRecordHash, and a fork (two records
  // claiming the same predecessor) is rejected by the database rather than
  // discovered during verification.
  @@unique([paymentRequestId, previousRecordHash])
  @@index([paymentRequestId, createdAt])
  /// The anchoring job's working set: everything not yet published.
  @@index([anchorId])
  @@index([hcsAnchorTxId]) // the anchoring job scans for NULL
}

/// One CRE vendor-match invocation, and the verdict that came back.
///
/// This table exists because CRE's HTTP trigger is fire-and-forget (D48):
/// `workflows.execute` returns an execution id and nothing else, and there is
/// no API to read a workflow's return value. So the workflow POSTs its verdict
/// back to /internal/vendor-match-result and the caller awaits the row.
///
/// It is also the correlation record that makes the callback safe. The row is
/// created BEFORE the workflow is invoked, so a callback naming a requestId
/// that does not exist here is rejected outright rather than trusted.
model VendorMatchRequest {
  /// The requestId handed to the workflow. Random, single-use, and the only
  /// thing the callback may use to address a verdict.
  id            String @id @default(uuid())
  vendorId      String
  /// Echoed back for auditing: what was asked, not just what was answered.
  walletAddress String
  network       String

  status VendorMatchRequestStatus @default(PENDING)

  /// Null until the callback lands. Read together with `status` — a null
  /// verdict on a COMPLETED row would be a bug, not "no match".
  match      Boolean?
  score      Float?
  reasonCode String?

  /// Returned by the gateway at invocation, so a stuck request can be traced
  /// with `cre execution status <id>`.
  workflowExecutionId String?
  /// Set when the workflow could not produce a verdict at all. A failure is
  /// NOT a negative verdict — the caller must fail closed, never treat "we
  /// could not check" as "we checked and it failed" (D44).
  failureReason       String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([vendorId, createdAt])
  @@index([status, createdAt]) // the awaiting caller polls on this
}

enum VendorMatchRequestStatus {
  PENDING
  COMPLETED
  FAILED
}

/// One World ID proof we accepted (B4, §4.6, D49/D49a).
///
/// The nullifier is an RP- and action-scoped identifier that is STABLE PER
/// PERSON: the same human verifying the same action returns the same value
/// forever. Verified twice against the live sandbox — fresh nonce, fresh proof,
/// different merkle root, identical nullifier (D49a). That stability is what
/// lets onboarding record a value and a later gate compare against it, without
/// us ever holding a face.
model WorldIdVerification {
  id String @id @default(uuid())

  /// DECIMAL, NOT HEX, and this is not a style preference (D49a).
  ///
  /// These are 256-bit field elements rendered as UNPADDED hex: an observed
  /// merkle_root came back 63 chars in one run and 64 in the next, a leading
  /// zero silently dropped. The nullifier is the same kind of value and will be
  /// short roughly one time in sixteen. Stored as text, one person would yield
  /// both "0x0abc…" and "0xabc…" — continuity comparisons would fail for a
  /// legitimate user, and the unique index below would not catch the replay it
  /// exists to catch. Converting to decimal collapses both spellings to one.
  nullifier Decimal @db.Decimal(78, 0)

  /// Scope of the nullifier. Changing this string changes the nullifier for the
  /// same human, so it must stay constant across enrollment and every later
  /// check or continuity breaks silently (D49).
  action String

  /// What the proof was bound to — the proposal, wallet or onboarding session.
  /// Part of the uniqueness key so one person may verify many times for
  /// DIFFERENT things but never twice for the same one.
  signal String

  /// "selfie" for Selfie Check, "proof_of_human" for Orb, etc. Recorded because
  /// assurance differs per credential and a reader must not have to guess.
  credential  String
  environment String

  /// Opaque handle for whoever this verification belongs to — a vendor id, an
  /// approver subject. Deliberately a plain string: this table must not force a
  /// foreign key onto every future subject type.
  subject String
  purpose WorldIdPurpose

  /// OUR clock. The upstream `created_at` is when the nullifier was FIRST EVER
  /// seen, not when this proof was verified — both runs in D49a returned an
  /// identical timestamp hours apart. Persisting upstream's value would put a
  /// wrong time in the evidence chain.
  verifiedAt DateTime @default(now())

  /// True when the World verifier flagged the nullifier as previously seen.
  /// DIAGNOSTIC ONLY — it still returns success:true on reuse, so this is never
  /// the control. The unique index is (D49a).
  upstreamReuse Boolean @default(false)

  @@unique([nullifier, action, signal])
  @@index([subject, purpose, verifiedAt])
}

enum WorldIdPurpose {
  /// Recorded at onboarding. The value every later check is compared against.
  ENROLLMENT
  /// Any later proof of "still the same human".
  REVERIFICATION
}

/// One batch of evidence records, committed to by a single Merkle root that was
/// published to a Hedera consensus topic.
///
/// DEVIATION: not in §3, which mentions only `hcsAnchorTxId` on each record.
/// A root, a record count and a sequence number are facts about the BATCH, and
/// copying them onto every member would mean the same values repeated across
/// hundreds of rows with nothing keeping them equal.
///
/// WHY THIS TABLE MATTERS. The hash chain proves nobody edited our records
/// without also editing every later one. It does not prove we did not rewrite
/// the whole chain, because the chain and the records share a database we
/// control. A root on a public topic does: it fixes a 32-byte commitment at a
/// consensus timestamp we cannot move (D19).
model EvidenceAnchor {
  id String @id @default(uuid())

  /// keccak256 Merkle root over the batch's payload hashes, 0x-prefixed.
  merkleRoot  String @unique
  recordCount Int

  topicId String
  /// Ordinal position in the topic. Cite this to fetch the message back.
  sequenceNumber Int
  /// Network consensus time, not our clock. This is the fact being anchored.
  consensusTimestamp String
  transactionId      String

  /// Public mirror-node URL for the message. Stored so a verifier is handed a
  /// link rather than told to construct one.
  messageUrl String

  /// False until the mirror node has served the message back. Anchoring is not
  /// finished when we submit it; it is finished when a third party can read it.
  verified   Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())

  records EvidenceRecord[]

  @@unique([topicId, sequenceNumber])
  @@index([createdAt])
}

/// The payee's answer to "someone wants to pay you" (P4).
///
/// SIGNED, not a flag. A database boolean saying "the payee agreed" is worth
/// nothing in a dispute — it is only our own assertion. The EIP-712 signature is
/// made by the CONFIRMED wallet that will receive the money, so consent is
/// non-repudiable and bound to the address being paid.
///
/// It also gates the match: no consent, no CRE run, nothing learned. That is
/// what stops the verification endpoint being a free identity oracle.
model PayeeConsent {
  id               String         @id @default(uuid())
  paymentRequestId String         @unique
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)

  decision PayeeConsentDecision

  /// EIP-712 signature over {paymentId, payeeAddress, amount, token, invoiceRef}.
  /// Absent on a DENY — refusing needs no proof, accepting does.
  signature      String?
  signerAddress  String?

  /// The World ID verification, when the risk engine demanded one (P5).
  /// Null means the challenge was not triggered, never that it failed.
  worldIdVerificationId String?

  decidedAt DateTime @default(now())

  @@index([decision, decidedAt])
}

enum PayeeConsentDecision {
  ACCEPTED
  DENIED
}

/// Something a party needs to see. Deliberately a row, not an email.
///
/// The record IS the notification: it is testable, it survives delivery
/// failure, and email or SMS becomes a delivery adapter over the top without
/// changing the flow.
model Notification {
  id String @id @default(uuid())

  /// Who it is for — a vendorId. Not a channel address; delivery is separate.
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  kind NotificationKind

  /// Structured, PII-free payload. Same discipline as the evidence chain (D27):
  /// identifiers, enums and amounts — never a name, PAN or document.
  payload Json

  paymentRequestId String?

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([vendorId, readAt, createdAt])
}

enum NotificationKind {
  /// P3: a payment is waiting for this payee to accept or deny.
  CONSENT_REQUESTED
  /// P6 failed: someone claimed this payee's identity and was wrong.
  /// The alarm that makes probing visible instead of silent.
  IDENTITY_MISMATCH
  /// The payee's HTLC lock is live and claimable.
  FUNDS_LOCKED
}

/// A payee refusing to be asked again by a specific payer.
///
/// Keyed on the payer's VENDOR ID — their verified identity — not a wallet
/// address. Addresses rotate in seconds; a DigiLocker-backed identity does not.
model IdentityBlock {
  id String @id @default(uuid())

  /// The payee doing the blocking.
  blockedByVendorId String
  blockedBy         Vendor @relation("BlockOwner", fields: [blockedByVendorId], references: [id], onDelete: Restrict)

  /// The payer being blocked.
  blockedVendorId String
  blocked         Vendor @relation("BlockTarget", fields: [blockedVendorId], references: [id], onDelete: Restrict)

  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockedByVendorId, blockedVendorId])
}
